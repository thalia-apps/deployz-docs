{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Deployz Documentation",
  "colors": {
    "primary": "#111111",
    "light": "#FAFAFA",
    "dark": "#111111"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "how-it-works",
              "concepts",
              "quickstart"
            ]
          },
          {
            "group": "Prepare your application",
            "pages": [
              "prepare/requirements",
              "prepare/not-supported",
              "prepare/environment-variables",
              "prepare/migrations"
            ]
          },
          {
            "group": "Releases",
            "pages": [
              "releases/create",
              "releases/build-failures"
            ]
          },
          {
            "group": "Test and share",
            "pages": [
              "share/test-deployment",
              "share/install-links",
              "share/invitations",
              "share/sizes-and-cost",
              "share/regions"
            ]
          },
          {
            "group": "Operate deployments",
            "pages": [
              "operate/deployment-status",
              "operate/deploy-update",
              "operate/rollback",
              "operate/restart",
              "operate/configuration",
              "operate/custom-domains",
              "operate/connector",
              "operate/remove"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/billing"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/overview",
              "reference/failure-codes",
              {
                "group": "By stage",
                "expanded": false,
                "pages": [
                  "troubleshooting/analysis",
                  "troubleshooting/install",
                  "troubleshooting/startup-and-health",
                  "troubleshooting/connector",
                  "troubleshooting/https-and-domains"
                ]
              }
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/aws-resources",
              "reference/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Customer guide",
        "groups": [
          {
            "group": "Customer guide",
            "pages": [
              "customers/overview",
              "customers/before-you-install",
              "customers/install",
              "customers/security",
              "customers/costs",
              "customers/custom-domain-dns",
              "customers/remove"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/android-chrome-192x192.png",
    "dark": "/images/app-icon-dark-180x180.png",
    "href": "https://deployz.dev"
  },
  "navbar": {
    "links": [
      {
        "href": "https://share.hsforms.com/1dOsn_DJtRhq47DXIaRjeLw5auur",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.deployz.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
