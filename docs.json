{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Deployz Documentation",
  "colors": {
    "primary": "#111111",
    "light": "#FAFAFA",
    "dark": "#111111"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "how-it-works",
              "concepts",
              "quickstart"
            ]
          },
          {
            "group": "Prepare your application",
            "pages": [
              "prepare/requirements",
              "prepare/not-supported",
              "prepare/analysis",
              "prepare/fix-findings",
              "prepare/environment-variables",
              "prepare/data-services",
              "prepare/workers-queues-schedules",
              "prepare/migrations"
            ]
          },
          {
            "group": "Releases",
            "pages": [
              "releases/create",
              "releases/build-failures"
            ]
          },
          {
            "group": "Test and share",
            "pages": [
              "share/test-deployment",
              "share/install-links",
              "share/invitations",
              "share/sizes-and-cost",
              "share/regions"
            ]
          },
          {
            "group": "Operate deployments",
            "pages": [
              "operate/deployment-status",
              "operate/deploy-update",
              "operate/rollback",
              "operate/restart",
              "operate/configuration",
              "operate/custom-domains",
              "operate/connector",
              "operate/remove"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/organization-and-team",
              "account/github",
              "account/billing"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/overview",
              "reference/failure-codes",
              {
                "group": "By stage",
                "expanded": false,
                "pages": [
                  "troubleshooting/analysis",
                  "troubleshooting/install",
                  "troubleshooting/startup-and-health",
                  "troubleshooting/connector",
                  "troubleshooting/https-and-domains"
                ]
              }
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/aws-resources",
              "reference/limits",
              "reference/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Customer guide",
        "groups": [
          {
            "group": "Customer guide",
            "pages": [
              "customers/overview",
              "customers/before-you-install",
              "customers/install",
              "customers/security",
              "customers/costs",
              "customers/custom-domain-dns",
              "customers/update-connector",
              "customers/remove"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/pipeline",
              "api/errors"
            ]
          },
          {
            "group": "Applications",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "overlays": [
                "api-reference/overlay.yaml"
              ]
            },
            "pages": [
              "GET /api/v1/applications",
              "GET /api/v1/applications/{id}"
            ]
          },
          {
            "group": "Releases",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "overlays": [
                "api-reference/overlay.yaml"
              ]
            },
            "pages": [
              "POST /api/v1/applications/{id}/releases",
              "GET /api/v1/applications/{id}/releases",
              "GET /api/v1/applications/{id}/releases/{releaseId}"
            ]
          },
          {
            "group": "Deployments",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "overlays": [
                "api-reference/overlay.yaml"
              ]
            },
            "pages": [
              "GET /api/v1/deployments",
              "GET /api/v1/deployments/{id}",
              "POST /api/v1/deployments/{id}/deploy",
              "POST /api/v1/deployments/{id}/restart",
              "POST /api/v1/deployments/{id}/rollback"
            ]
          },
          {
            "group": "Operations",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference",
              "overlays": [
                "api-reference/overlay.yaml"
              ]
            },
            "pages": [
              "GET /api/v1/deployments/{id}/jobs/{jobId}"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/android-chrome-192x192.png",
    "dark": "/images/app-icon-dark-180x180.png",
    "href": "https://deployz.dev"
  },
  "navbar": {
    "links": [
      {
        "href": "https://share.hsforms.com/1dOsn_DJtRhq47DXIaRjeLw5auur",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.deployz.dev"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Support",
        "items": [
          {
            "label": "Support form",
            "href": "https://share.hsforms.com/1dOsn_DJtRhq47DXIaRjeLw5auur"
          },
          {
            "label": "help@deployz.dev",
            "href": "mailto:help@deployz.dev"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Run your web application in your customers' own AWS accounts. Guides for software vendors and their customers.",
  "appearance": {
    "strict": true,
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  }
}
